generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetProvider {
  LOCAL
  CLOUDINARY
}

enum AssetStatus {
  ACTIVE
  ORPHANED
  DELETED
}

model PortfolioState {
  id                  String             @id @default("main")
  draftPayload        Json
  draftVersion        Int                @default(1)
  publishedRevisionId String?            @unique
  publishedRevision   PortfolioRevision? @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model PortfolioRevision {
  id                String          @id @default(cuid())
  version           Int             @unique
  payload           Json
  createdByGithubId String
  createdByLogin    String?
  rollbackOfId      String?
  note              String?
  createdAt         DateTime        @default(now())
  publishedAt       DateTime        @default(now())
  publishedState    PortfolioState? @relation("PublishedRevision")

  @@index([createdAt])
}

model Asset {
  id                String        @id @default(cuid())
  provider          AssetProvider
  status            AssetStatus   @default(ACTIVE)
  publicId          String?
  url               String
  resourceType      String        @default("image")
  format            String?
  width             Int?
  height            Int?
  bytes             Int?
  originalName      String?
  altText           String?
  createdByGithubId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@unique([provider, publicId])
  @@index([status])
}

model AuditEvent {
  id            String   @id @default(cuid())
  action        String
  entityType    String
  entityId      String?
  actorGithubId String
  actorLogin    String?
  revisionId    String?
  assetId       String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
